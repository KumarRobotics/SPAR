(define (problem watering-hard-2)
  (:domain uavWatering)
  (:objects u1 u2 - uav p1 p2 - pot l1 l2 l3 l4 - location)
  (:init
    (at-uav u1 l1)
    (at-uav u2 l2)
    (at-pot p1 l1)
    (at-pot p2 l2)
    (empty u1)
    (empty u2)
    (home l1)
    (= (capacity p1) 10)
    (= (capacity p2) 6)
    (= (water-level p1) 10)
    (= (water-level p2) 6)

    (= (need-water l3) 5)
    (= (need-water l4) 6)
    (= (need-water l1) 1)
    (= (need-water l2) 12)
  )
  (:goal (and (done l3) (done l4) (done l1) (done l2)))
)