(define (problem watering-medium-3)
  (:domain uavWatering)
  (:objects u1 - uav p1 p2 - pot l1 l2 - location)
  (:init
    (at-uav u1 l1)
    (at-pot p1 l1)
    (at-pot p2 l1)
    (empty u1)
    (home l1)

    (= (capacity p1) 3)
    (= (capacity p2) 8)
    (= (water-level p1) 8)
    (= (water-level p2) 10)
    (= (need-water l2) 4)
    (= (need-water l1) 5)
  )
  (:goal (and (done l2) (done l1)))
)