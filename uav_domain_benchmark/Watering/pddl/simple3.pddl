(define (problem watering-simple-3)
  (:domain uavWatering)
  (:objects u1 - uav p1 - pot l1 - location)
  (:init
    (at-uav u1 l1)
    (at-pot p1 l1)
    (empty u1)
    (home l1)
    (= (capacity p1) 5)
    (= (water-level p1) 1)
    (= (need-water l1) 3)
  )
  (:goal (and (= (water-level p1) 0)))
)