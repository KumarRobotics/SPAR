(define (problem watering-hard-3)
  (:domain uavWatering)
  (:objects u1 u2 - uav p1 p2 - pot l1 l2 l3 l4 - location)
  (:init
    (at-uav u1 l1)
    (at-uav u2 l1)
    (at-pot p1 l1)
    (at-pot p2 l2)
    (empty u1)
    (empty u2)
    (home l2)
    (= (capacity p1) 5)
    (= (capacity p2) 5)
    (= (water-level p1) 0)
    (= (water-level p2) 0)
    (= (need-water l1) 3)
    (= (need-water l2) 4)
    (= (need-water l3) 2)
    (= (need-water l4) 1)
  )
  (:goal (and (done l1) (done l2) (done l3) (done l4)))
)