(define (problem perch-hard-3)
  (:domain UAV-Perching)
  (:objects u1 u2 - uav l1 l2 l3 l4 l5 l6 - location)
  (:init
    (at u1 l1)
    (perched u1)
    (at u2 l2)
    (perched u2)
    (connected l1 l3)
    (connected l3 l4)
    (connected l2 l5)
    (connected l5 l6)
    (clear l4)
    (clear l6)
  )
  (:goal (and
    (perched u1)
    (perched u2)
    (at u1 l4)
    (at u2 l6)
    (perch-visit l4)
    (perch-visit l6)
  ))
)
