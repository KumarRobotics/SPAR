(define (problem perch-hard-1)
  (:domain UAV-Perching)
  (:objects u1 u2 - uav l1 l2 l3 l4 - location)
  (:init
    (at u1 l1)
    (perched u1)
    (at u2 l2)
    (perched u2)
    (connected l1 l3)
    (connected l2 l4)
    (clear l3)
    (clear l4)
  )
  (:goal (and
    (perch-visit l3)
    (perch-visit l4)
    (perched u1)
    (perched u2)
    (at u1 l3)
    (at u2 l4)
  ))
)
