; 3 components
(define (problem maintenance-prob-9)
  (:domain uav_maintenance)
  (:objects u1 - uav c1 c2 c3 - component)
  (:init 
    (available u1)
    (bad-state c1)
    (not (bad-state c2))
    (not (bad-state c3))
    (= (heat c1) 20)
    (= (heat c2) 60)
    (= (heat c3) 30)
    (= (max_heat) 50)
  )
  (:goal 
    (and
      (image_analyzed c1)
      (image_analyzed c2)
      (image_analyzed c3)
      (heat_analyzed c1)
      (heat_analyzed c2)
      (heat_analyzed c3)
    )
  )
)
