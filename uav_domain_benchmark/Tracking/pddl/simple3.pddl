(define (problem tracking-simple-3)
  (:domain trackingdomain)
  (:objects u1 - uav p1 p2 - position)
  (:init 
    (at u1 p1)
    (next-uav p1 p2)
    (next-goal p2 p1)
    (current-goal p2)
    (= (cost) 0)
  )
  (:goal 
    (and (at u1 p2)
         (current-goal p1)
         (reach-subgoal p2))
  )
  (:metric minimize (cost))
)
